{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "node scripts/genre-tagger-incremental.js",
    "restartPolicyType": "NEVER"
  },
  "cron": {
    "schedule": "0 11 * * *",
    "description": "Score new grants daily at 3 AM Pacific Time (11 AM UTC), 1 hour after database sync"
  }
}
