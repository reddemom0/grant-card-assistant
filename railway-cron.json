{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "node scripts/sync-getgranted-database.js",
    "restartPolicyType": "NEVER"
  },
  "cron": {
    "schedule": "0 2 * * 0",
    "description": "Sync GetGranted database every Sunday at 2 AM UTC"
  }
}
