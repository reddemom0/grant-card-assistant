{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "node scripts/sync-getgranted-database.js",
    "restartPolicyType": "NEVER"
  },
  "cron": {
    "schedule": "0 10 * * *",
    "description": "Sync GetGranted database daily at 2 AM Pacific Time (10 AM UTC)"
  }
}
