# Grant Card Assistant - Environment Variables
# Copy this to .env and fill in your values for local development
# For Railway deployment, set these in Railway's environment variables

# ============================================================================
# REQUIRED - Claude AI API
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================================
# REQUIRED - Database
# ============================================================================
DATABASE_URL=postgresql://user:password@host:5432/database
# Alternative name (will check both)
POSTGRES_URL=postgresql://user:password@host:5432/database

# ============================================================================
# OPTIONAL - HubSpot CRM Integration
# ============================================================================
HUBSPOT_ACCESS_TOKEN=pat-na1-...

# ============================================================================
# OPTIONAL - Google Drive Integration
# ============================================================================
GOOGLE_DRIVE_CLIENT_ID=...
GOOGLE_DRIVE_CLIENT_SECRET=...
GOOGLE_DRIVE_REFRESH_TOKEN=...

# ============================================================================
# OPTIONAL - Google Service Account (for knowledge base)
# ============================================================================
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
GOOGLE_DRIVE_FOLDER_ID=...

# ============================================================================
# OPTIONAL - Environment
# ============================================================================
NODE_ENV=development
PORT=3000

# ============================================================================
# OPTIONAL - JWT Authentication
# ============================================================================
JWT_SECRET=your-secret-key
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# ============================================================================
# OPTIONAL - Public deployment URL (required for Granola MCP OAuth)
# ============================================================================
# Stable origin under which the hub is reachable. Used to build the
# OAuth redirect URI registered with remote MCP authorization servers
# (e.g. Granola). No trailing slash.
PUBLIC_URL=https://your-deployment.up.railway.app

# ============================================================================
# OPTIONAL - Oracle match explanations for GetGranted troubleshooting
# ============================================================================
# gg3-ai-service base URL and its REVIEW_FEED_TOKEN. Unset: Oracle troubleshoots
# without the match explanation. The Control Centre review sweep also uses them
# for match diagnosis (mode=bad_match); unset, match items stay 'new'.
GG3_AI_SERVICE_URL=
GG3_REVIEW_FEED_TOKEN=
# The same two also feed src/services/match-lead-client.js (POST
# /api/v1/ai/internal/match-lead); unset, it returns { ok: false }.

# ============================================================================
# OPTIONAL - Opt-in Gmail access (per user, never part of sign-in)
# ============================================================================
# Comma-separated emails allowed to open /api/auth/gmail and grant Oracle
# gmail.readonly + gmail.compose. Unset: nobody can connect Gmail.
GMAIL_CONSENT_ALLOWLIST=

# ============================================================================
# OPTIONAL - Control Centre read-only access to the GetGranted app DB
# ============================================================================
# ai-api-backend Postgres as a read-only role (never postgres). Unset: the
# Control Centre reports the app DB as not configured. See docs/control-centre.md.
APP_DB_READONLY_URL=

# Control Centre nightly roll-up into cc_daily_* (migration 043). Off unless
# exactly "true". Needs APP_DB_READONLY_URL and GG3_OPS_DB_READONLY_URL.
CC_ROLLUP_ENABLED=

# Control Centre hourly review sweep (migration 044): files client 👎s as
# review-queue flags. Off unless exactly "true". Needs APP_DB_READONLY_URL.
# Diagnosis also needs ANTHROPIC_API_KEY (Sonnet 5.5 narrative),
# GG3_AI_SERVICE_URL + GG3_REVIEW_FEED_TOKEN (match items) and
# GG3_OPS_DB_READONLY_URL (chat items); without them items wait in 'new'.
CC_REVIEW_SWEEP_ENABLED=
